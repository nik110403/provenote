#!/usr/bin/env python3
"""Check that every cited paragraph in a draft is backed by notes whose quotes verify.

Usage: check-claims [--strict-quotes] [--root <project>] <draft.md>

Finds paragraphs carrying a pandoc citation ([@key], [@a; @b], [@{key}], narrative @key) and maps
each key to <project>/01_notes/lit/<key>.md. With --root the project is given. Without it, every folder
that holds 01_notes/lit among the draft's ancestors (lexical and physical path) and the current directory
is a candidate: exactly one is used, none means no notes, more than one is an error (exit 2, pass --root).
The notes folder used is printed to stderr as `notes: <path>`. Code, HTML comments, URLs and emails are ignored. Every cited note is run through
verify-quotes' checks (strict about md_sha256 when 02_sources/manifest.csv records it).
Prints a markdown table with one row per (paragraph, key):
  OK          the note exists, has quotes, and every quote verifies against its source
  NO-SOURCE   the note declares a source that cannot be quoted (software, data, print book)
  UNVERIFIED  no note, a note without quotes, a failing note, or a quotation (4+ words) in the
              paragraph that no cited source holds verbatim, or an unbalanced quotation mark
  UNCITED     a quotation (4+ words) in a paragraph with no citation
The note-level checks (no note, failing note, note without quotes, no citation) always fail the
run. The draft-quote checks (UNCITED, and UNVERIFIED caused only by a draft quotation) are
heuristic: they are printed as `UNVERIFIED (advisory)` / `UNCITED (advisory)` and fail the run
only with --strict-quotes.
  UNSOURCED   informational: the block follows `<!-- unsourced: <reason> -->`, so its quotations
              are not matched against a source (own interview, translation, epigraph, hypothesis)
A block is a paragraph plus what belongs to it: a blockquote next to it, the footnote its `[^n]`
points to, and the list or paragraph after a line ending in ":". Quotations are "", “”, „“, ‚‘, ‘’,
«», »«, ‹›, 「」, 『』, <q>, <blockquote> and `>` lines. Unquoted paraphrase is not judged.
Exits 1 if any note-level row is UNVERIFIED, or no citation is recognised (with --strict-quotes
also if any advisory row); 2 on usage error or an ambiguous notes folder.
No model calls, no network. Needs verify-quotes in the same directory.
"""
from __future__ import annotations

import sys

if sys.version_info < (3, 9):
    sys.exit("check-claims needs Python 3.9 or newer")

import html
import importlib.machinery
import importlib.util
import os
import re
from pathlib import Path

KEY = r"\w(?:\w|[:.#$%&+?<>~-](?=\w))*"
CITE_RE = re.compile(r"(?<![\w@/])-?@(?:\{([^{}\n]+)\}|(" + KEY + "))")
CITE_BRACKET = re.compile(r"\[[^\[\]]*@[^\[\]]*\]")
FENCE_RE = re.compile(r"^[ \t]*(`{3,}(?![^\n]*`)|~{3,})[^\n]*\n.*?(?:^[ \t]*\1[^\n]*$|\Z)", re.S | re.M)
CODE_RE = re.compile(r"(`+)((?:(?!\n[ \t]*\n).)+?)\1", re.S)
COMMENT_RE = re.compile(r"<!--.*?-->", re.S)
URL_RE = re.compile(r"(?:[A-Za-z][\w+.-]*://|www\.)[^\s)\]\[>]*")
EMAIL_RE = re.compile(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+")
SPACES = re.compile(r"[\s\x00-\x1f\x7f-\x9f\u2028\u2029]+")
MARKER_RE = re.compile(r"^[ \t]*<!--\s*unsourced:\s*(\S.*?)\s*-->[ \t]*$")
FOOTDEF_RE = re.compile(r"^\[\^([^\]]+)\]:")
PAIRS = re.compile("|".join([
    r"“([^“”]*)”", r"„([^„“”]*)[“”]", r"«([^«»]*)»", r"»([^«»]*)«", r"‹([^‹›]*)›", r"›([^‹›]*)‹",
    r"「([^「」]*)」", r"『([^『』]*)』", r"<q>(.*?)</q>", r'"([^"]*)"',
    r"‚((?:[^‚‘’]|(?<=\w)’(?=\w))*)(?:(?<!\w)[‘’]|[‘’](?!\w))",
    r"‘((?:[^‘’]|(?<=\w)’(?=\w))*)(?:(?<!\w)’|’(?!\w))",
    r"(?<![^\s(\[])'(?P<s1>(?:[^']|(?<=\w)'(?=\w))*)(?:(?<!\w)'|'(?!\w))",
]), re.S)
STRAY = re.compile(r"[“”\"„«»「『]")
STRAY_OPEN = re.compile(r"(?<![^\s(\[])['‘‚](?=[^\W\d_]\S*(?:\s+\S+){3})")
LOCATOR = re.compile(r"\s*\([^()]*\bpp?\.\s*\d[^()]*\)\s*$")
ELLIPSIS_OR_INSERT = re.compile(r"(\.\s?\.\s?\.|…|\[[^\[\]]*\])")
MIN_QUOTE_WORDS, MIN_QUOTE_CJK = 4, 8


def load_vq():
    path = Path(__file__).resolve().parent / "verify-quotes"
    loader = importlib.machinery.SourceFileLoader("verify_quotes", str(path))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("verify_quotes", loader))
    loader.exec_module(mod)
    return mod


class NoteProbeError(Exception):
    pass


def note_candidates(draft: Path) -> dict[Path, Path]:
    """Every distinct (resolved) <B>/01_notes/lit directory for B in the draft's ancestors, taken lexically
    (unresolved) and physically (realpath), and the current directory and ITS ancestors taken both ways. No ordering is
    applied: the caller accepts exactly one, so no planted folder can win by position."""
    cwd = Path(os.getcwd())
    pwd = os.environ.get("PWD")
    cwds = [cwd]
    if pwd and os.path.isabs(pwd) and os.path.realpath(pwd) == os.path.realpath(cwd):
        cwds.append(Path(pwd))  # the shell's (possibly symlinked) view of the cwd
    here = [Path(os.path.abspath(c / draft)).parent for c in cwds]  # relative drafts: both views of the cwd
    here += [Path(os.path.realpath(draft)).parent, Path(os.path.realpath(here[0]))]
    cwds.append(Path(os.path.realpath(cwd)))
    bases = [b for h in (*here, *cwds) for b in (h, *h.parents)]  # draft and cwd, each with all ancestors
    found: dict[Path, Path] = {}  # resolved -> first (unresolved) path, which is what verify-quotes must see
    for b in bases:
        lit = b / "01_notes/lit"
        try:
            if lit.is_dir():
                found.setdefault(lit.resolve(), lit)
        except OSError as e:
            raise NoteProbeError(f"cannot inspect {lit}: {e}") from e
    return found


def _blank(m: re.Match) -> str:
    return re.sub(r"[^\n]", " ", m.group(0))


def keys_in(text: str) -> list[str]:
    out: list[str] = []
    for m in CITE_RE.finditer(text):
        k = m.group(1) or m.group(2)
        if k not in out:
            out.append(k)
    return out


class Seg:
    """One paragraph-like run of lines: masked (for parsing) and original (for display)."""
    def __init__(self, start, m, o, marker=None):
        self.start, self.m, self.o, self.marker = start, m, o, marker

    @property
    def text(self):
        return " ".join(self.m)

    @property
    def is_bq(self):
        return all(l.startswith(">") for l in self.m)


def blocks(text: str) -> list[list[Seg]]:
    """Blocks of segments. Masks code, comments, URLs, emails; honours unsourced markers."""
    orig = text.splitlines()
    t = FENCE_RE.sub(_blank, text)
    markers = {}
    for i, line in enumerate(t.splitlines(), 1):
        m = MARKER_RE.match(line)
        if m:
            markers[i + 1] = m.group(1)
    for rx in (COMMENT_RE, CODE_RE):
        t = rx.sub(_blank, t)
    # entities are decoded only after fences/comments/code are masked (an encoded `&lt;!--` is never a
    # comment) and before URLs/emails are masked (an encoded space ends a URL). Whitespace, control and
    # line-separator characters, also decoded ones, become one space so no cell can forge a table line.
    def clean(l):
        return SPACES.sub(" ", html.unescape(l))
    lines = [EMAIL_RE.sub(_blank, URL_RE.sub(_blank, clean(l))) for l in t.splitlines()]
    segs, start, buf = [], 1, []
    for i, line in enumerate(lines + [""], 1):
        if line.strip():
            if not buf:
                start = i
            buf.append(i - 1)
        elif buf:
            segs.append(Seg(start, [lines[j].strip() for j in buf],
                            [clean(orig[j]) if j < len(orig) else "" for j in buf], markers.get(start)))
            buf = []
    # footnote definitions belong to the paragraphs that reference them
    defs, plain = {}, []
    for sg in segs:
        fm = FOOTDEF_RE.match(sg.m[0])
        if fm:
            defs[fm.group(1)] = sg
        else:
            plain.append(sg)
    blks = [[sg] for sg in plain]
    used = set()
    for blk in blks:
        for fid, d in defs.items():
            if re.search(r"\[\^" + re.escape(fid) + r"\](?!:)", blk[0].text):
                blk.append(d)
                used.add(fid)
    for fid, d in defs.items():
        if fid not in used:
            blks.append([d])
    blks.sort(key=lambda b: b[0].start)

    def cited(b):
        return bool(keys_in(" ".join(s.text for s in b)))

    out, pending = [], []
    for b in blks:
        if out and out[-1][-1].m[-1].rstrip().endswith(":"):  # "as Lei puts it:" + the list/paragraph after
            out[-1] += b
            continue
        if b[0].is_bq and not cited(b):
            if out and cited(out[-1]):
                out[-1] += b
            else:
                pending += b
            continue
        if pending:
            if cited(b):
                b = pending + b
            else:
                out.append(pending)
            pending = []
        out.append(b)
    if pending:
        out.append(pending)
    return out


def quotes_in(seg: Seg) -> tuple[list[str], bool]:
    """(quoted passages, unbalanced quotation mark present) for one segment."""
    quotes, prose, bq = [], [], []
    for l in seg.m + [""]:
        if l.startswith(">"):
            bq.append(l.lstrip(">").strip())
            continue
        if bq:
            t = LOCATOR.sub("", CITE_BRACKET.sub(" ", " ".join(bq)))
            quotes.append(t)
            bq = []
        if l:
            prose.append(l)
    text = " ".join(prose)
    for m in re.finditer(r"<blockquote[^>]*>(.*?)</blockquote>", text, re.S | re.I):
        quotes.append(LOCATOR.sub("", CITE_BRACKET.sub(" ", re.sub(r"<[^>]+>", " ", m.group(1)))))
    text = re.sub(r"<blockquote[^>]*>.*?</blockquote>", " ", text, flags=re.S | re.I)
    text = CITE_RE.sub(" ", text)
    text = re.sub(r"(?<=\d)[\"”]", " ", text)  # inch / foot marks
    for m in PAIRS.finditer(text):
        if m.group("s1") is not None and len(m.group("s1").split()) < MIN_QUOTE_WORDS:
            continue  # apostrophes, not quotation marks
        quotes.append(next(g for g in m.groups() if g is not None))
    left = PAIRS.sub(" ", text)
    return quotes, bool(STRAY.search(left) or STRAY_OPEN.search(left))


def _plain(vq, q: str) -> str:
    q = re.sub(r"\*+", "", q)
    q = re.sub(r"(?<!\w)_+|_+(?!\w)", "", q)
    return q.strip().rstrip(",.;:!?").strip()


def is_term(vq, q: str) -> bool:
    """A quote too short to be judged alone (scare quote, term)."""
    norm = vq._ws(_plain(vq, q))
    if vq.CJK_RE.search(norm):
        return len(norm) < MIN_QUOTE_CJK
    return len(norm.split()) < MIN_QUOTE_WORDS


def quote_pieces(vq, q: str, whole: bool = False):
    """(text, left_boundary, right_boundary, first) pieces to match in order. Every non-empty piece
    counts and is matched on word boundaries, except next to a [bracketed insertion]. whole: a short quote kept whole."""
    q = _plain(vq, q)
    if whole:
        t = vq._ws(q)
        return [(t, True, True, True)] if re.search(r"\w", t) else []
    parts = ELLIPSIS_OR_INSERT.split(q)
    pieces = []
    for i in range(0, len(parts), 2):
        t = vq._ws(parts[i])
        if not re.search(r"\w", t):
            continue
        after_insert = i > 0 and parts[i - 1].startswith("[")
        before_insert = i + 1 < len(parts) and parts[i + 1].startswith("[")
        pieces.append((t, not after_insert, not before_insert, i == 0))
    return pieces


def held(vq, pieces, variants) -> bool:
    """All pieces occur in the source, in order (first letter of the quote case-insensitive)."""
    if not pieces:
        return False
    for v in variants:
        pos = 0
        for t, lb, rb, first in pieces:
            pos = vq.find_in(t, v, pos, lb, rb, ci=first)
            if pos < 0:
                break
        else:
            return True
    return False


def main(argv: list[str]) -> int:
    for _s in (sys.stdout, sys.stderr):  # UTF-8 output regardless of the locale (e.g. Windows cp1252)
        try:
            _s.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError, OSError):
            pass
    if any(a in ("-h", "--help") for a in argv[1:]):
        print(__doc__ + "Requires: python3 >= 3.9 (stdlib only).")
        return 0
    usage = "usage: check-claims [--strict-quotes] [--root <project>] <draft.md>"
    strict_quotes, root_arg, args, it = False, None, [], iter(argv[1:])
    for a in it:
        if a == "--strict-quotes":
            strict_quotes = True
        elif a == "--root":
            root_arg = next(it, None)
            if root_arg is None:
                print(usage, file=sys.stderr)
                return 2
        elif a.startswith("--root="):
            root_arg = a[7:]
        else:
            args.append(a)
    if len(args) != 1:
        print(usage, file=sys.stderr)
        return 2
    draft = Path(args[0])
    try:
        text = draft.read_bytes().decode("utf-8-sig")
        vq = load_vq()
    except UnicodeDecodeError:
        print("check-claims: draft is not valid UTF-8", file=sys.stderr)
        return 2
    except (OSError, ImportError) as e:
        print(f"check-claims: cannot read draft or verify-quotes: {e}", file=sys.stderr)
        return 2
    if root_arg is not None:
        notes = Path(os.path.abspath(root_arg)) / "01_notes/lit"
        if not notes.is_dir():
            print(f"check-claims: --root {root_arg}: {notes} is not a directory", file=sys.stderr)
            return 2
    else:
        try:
            cands = note_candidates(draft)
        except NoteProbeError as e:
            print(f"check-claims: {e} -- pass --root <project>", file=sys.stderr)
            return 2
        if len(cands) > 1:
            print("check-claims: ambiguous notes folder: " + ", ".join(str(c) for c in cands)
                  + " -- pass --root <project>", file=sys.stderr)
            return 2
        notes = next(iter(cands.values())) if cands else None
    print(f"notes: {notes if notes else '(none found)'}", file=sys.stderr)
    cache: dict = {}

    def note_state(k: str):
        """(reason or '', whole-source variants or None, no-source reason or None)."""
        if k in cache:
            return cache[k]
        res = (f"no note {k}.md", None, None)
        path = notes / f"{k}.md" if notes else None
        if "/" in k or "\\" in k or k.startswith("."):
            res = ("invalid citation key", None, None)
        elif path is not None and path.is_file():
            results, nq, src, nosrc = vq.check_note_full(path, "auto")
            bad = [m for ok, m in results if not ok]
            if vq.project_root(path).resolve() != notes.parent.parent.resolve():
                bad.append(f"{k}.md: verify-quotes would use a different project root "
                           f"({vq.project_root(path)}) than the notes folder's project; pass --root")
            whole = None
            if src is not None:
                try:
                    _, body, _ = vq.load_source(src, k, "auto", root=vq.project_root(path))
                    whole = vq.variants(vq.PAGE_RE.sub("\n", body))
                except (OSError, ValueError):
                    pass
            if bad:
                res = (bad[0].split(": ", 1)[-1] + (f" (+{len(bad) - 1} more)" if len(bad) > 1 else ""), whole, nosrc)
            elif nosrc is not None:
                res = ("", None, nosrc)
            elif not nq:
                res = ("note has no quotes", whole, None)
            else:
                res = ("", whole, None)
        cache[k] = res
        return res

    print("| line | key | status | paragraph | detail |\n|---|---|---|---|---|")
    bad = adv = nosrc_rows = n_cited = 0
    rows_out = []
    cells = lambda x: x.replace("|", "/")

    def emit(n, key, st, para, detail):
        rows_out.append(f"| {n} | {key} | {st} | {cells(para)} | {cells(detail)} |")

    for blk in blocks(text):
        n = blk[0].start
        keys = keys_in(" ".join(sg.text for sg in blk))
        para = " ".join(l.strip() for l in blk[0].o)
        para = para if len(para) <= 100 else para[:97] + "..."
        full, terms, unbalanced = [], [], False
        for sg in blk:
            if sg.marker:
                continue
            qs, unb = quotes_in(sg)
            unbalanced |= unb
            for q in qs:
                (terms if is_term(vq, q) else full).append(q)
        reasons = [sg.marker for sg in blk if sg.marker]
        if not keys:
            if full:
                adv += 1
                emit(n, "-", "UNCITED (advisory)", para, "quotation without a citation (cite its source, or mark the block "
                     "<!-- unsourced: reason -->): " + "; ".join(f'"{q.strip()}"' for q in full))
        else:
            n_cited += 1
            states = {k: note_state(k) for k in keys}
            problems, notes_on = [], []
            if unbalanced:
                problems.append("unbalanced quotation mark (close it, or the quote cannot be checked)")
            srcs = [k for k in keys if states[k][1] is not None]
            nos = [k for k in keys if states[k][2] is not None]
            checks = [(q, quote_pieces(vq, q)) for q in full]
            if sum(len(vq._ws(_plain(vq, q)).split()) for q in terms if re.search(r"\w", q)) >= MIN_QUOTE_WORDS:
                checks += [(q, quote_pieces(vq, q, whole=True)) for q in terms]
            for q, pieces in checks:
                holders = [k for k in srcs if held(vq, pieces, states[k][1])]
                if holders:
                    notes_on.append("quote held by " + ", ".join(holders))
                    continue
                if srcs or not nos:
                    problems.append(f'quote not verbatim in {", ".join(srcs or keys)} source '
                                    f'(check ellipsis/brackets/case): "{q.strip()}"')
                if nos:
                    problems.append(f'no source text for {", ".join(nos)} (NO-SOURCE); '
                                    f'verify by hand or mark unsourced: "{q.strip()}"')
            for k in keys:
                why, _, nosrc = states[k]
                if why:
                    st, detail = "UNVERIFIED", why
                elif problems:
                    st, detail = "UNVERIFIED (advisory)", "; ".join(problems)
                elif nosrc is not None:
                    st, detail = "NO-SOURCE", nosrc
                else:
                    st, detail = "OK", "; ".join(dict.fromkeys(notes_on))
                bad += st == "UNVERIFIED"
                adv += st == "UNVERIFIED (advisory)"
                nosrc_rows += st == "NO-SOURCE"
                emit(n, k, st, para, detail)
        if reasons:
            emit(n, "-", "UNSOURCED", para, "quotations not matched against a source: " + "; ".join(reasons))
    if strict_quotes:
        rows_out = [r.replace(" (advisory) |", " |", 1) for r in rows_out]
    print("\n".join(rows_out))
    extra = f"; {nosrc_rows} NO-SOURCE" if nosrc_rows else ""
    if adv and not strict_quotes:
        print("\nadvisory: draft-quote check is heuristic; run with --strict-quotes to make it fail")
    print(f"\n{n_cited} cited paragraph(s); {bad + (adv if strict_quotes else 0)} row(s) not OK{extra}; "
          f"{0 if strict_quotes else adv} advisory.")
    if not n_cited:
        print("check-claims: no citations recognised in the draft (expected [@key] or @key)", file=sys.stderr)
        return 1
    return 1 if bad or (strict_quotes and adv) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

#!/usr/bin/env python3
"""Create an analysis pipeline from the bundled template.

Usage: new-pipeline <target-dir> --lang python|r
Refuses a target that exists and is not an empty directory.
Exit codes: 0 created, 1 refused, 2 usage error.
"""
import shutil
import sys
from pathlib import Path

if sys.version_info < (3, 9):
    sys.exit("new-pipeline needs Python 3.9 or newer")

TEMPLATES = Path(__file__).resolve().parent.parent / "templates" / "pipeline"


def create(target: Path, lang: str) -> None:
    if target.exists() and not target.is_dir():
        raise FileExistsError(f"{target} exists and is not a directory")
    if target.is_dir() and any(target.iterdir()):
        raise FileExistsError(f"{target} is not empty")
    shutil.copytree(TEMPLATES / lang, target, dirs_exist_ok=True)


def main(argv: list) -> int:
    for _s in (sys.stdout, sys.stderr):  # UTF-8 output regardless of the locale (e.g. Windows cp1252)
        try:
            _s.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError, OSError):
            pass
    usage = "usage: new-pipeline <target-dir> --lang python|r"
    if any(a in ("-h", "--help") for a in argv[1:]):
        print(__doc__ + "Requires: python3 >= 3.9 (stdlib only).")
        return 0
    if len(argv) != 4 or argv[2] != "--lang" or argv[3] not in ("python", "r"):
        print(usage, file=sys.stderr)
        return 2
    try:
        create(Path(argv[1]), argv[3])
    except FileExistsError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    print(f"created {argv[1]}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
